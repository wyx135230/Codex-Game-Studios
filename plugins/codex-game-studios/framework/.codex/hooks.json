{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/studio.py\" hook SessionStart",
            "commandWindows": "python -c \"import os,runpy,subprocess,sys; p=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.argv=['studio.py','hook','SessionStart']; runpy.run_path(os.path.join(p,'scripts','studio.py'),run_name='__main__')\"",
            "timeout": 120
          }
        ]
      }
    ],
